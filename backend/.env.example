# VoiceMate local runtime config.
# Copy to backend/.env and fill real secrets. Do not commit backend/.env.

VOICEMATE_HOST=0.0.0.0
VOICEMATE_PORT=8000
VOICEMATE_PUBLIC_HOST=192.168.10.233

# LLM
DEEPSEEK_API_KEY=sk-put_your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
VOICEMATE_CHAT_MAX_TOKENS=220
VOICEMATE_LLM_MAX_TOKENS=48
VOICEMATE_REALTIME_ONE_SENTENCE=1
VOICEMATE_REALTIME_MAX_REPLY_CHARS=32
VOICEMATE_REALTIME_MIN_REPLY_CHARS=8

# LiveKit RTC. Keep LiveKit for LAN first; switch to Volcengine RTC only if latency/network requires it.
LIVEKIT_HOST=192.168.10.233
LIVEKIT_PORT=7880
LIVEKIT_URL=ws://192.168.10.233:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=VoiceMate
VOICEMATE_RTC_PROVIDER=livekit

# Volcengine RTC preparation. Keep LiveKit active until iOS Volcengine RTC SDK
# and a valid token service are configured.
VOLCENGINE_RTC_APP_ID=
VOLCENGINE_RTC_APP_KEY=
VOLCENGINE_RTC_TOKEN_URL=

# Volcengine streaming ASR.
VOLCENGINE_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLCENGINE_ASR_APP_KEY=your_app_id
VOLCENGINE_ASR_ACCESS_KEY=your_access_token
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
VOLCENGINE_ASR_VAD_SEGMENT_MS=800
VOLCENGINE_ASR_END_WINDOW_MS=260
VOLCENGINE_ASR_FORCE_SPEECH_MS=6000
VOLCENGINE_ASR_TIMEOUT_SECONDS=18
VOLCENGINE_ASR_FLUSH_GRACE_MS=260
VOLCENGINE_ASR_AUTO_FINAL_MS=650

VOICEMATE_ASR_MIN_AUDIO_SECONDS=0.75
VOICEMATE_ASR_MIN_RMS=180
VOICEMATE_ASR_MAX_NO_SPEECH_PROB=0.65
VOICEMATE_ASR_MIN_TEXT_CHARS=2

# Volcengine TTS.
VOLCENGINE_TTS_API_KEY=your_api_key
VOLCENGINE_TTS_RESOURCE_ID=volc.service_type.10029
VOLCENGINE_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOLCENGINE_TTS_VOICE_TYPE=zh_female_qingxinnvsheng_mars_bigtts
VOLCENGINE_TTS_MODEL=seed-tts-2.0-expressive
VOLCENGINE_TTS_TIMEOUT_SECONDS=18
VOLCENGINE_TTS_MIN_SEGMENT_CHARS=3
VOLCENGINE_TTS_MAX_SEGMENT_CHARS=10
VOICEMATE_PREWARM_TTS_ACKS=1
VOICEMATE_REALTIME_ACK_ENABLED=0
VOICEMATE_STARTUP_PREWARM=1

# Turn detection and interruption.
VOICEMATE_TURN_DETECTION=stt
VOICEMATE_MIN_ENDPOINTING_DELAY=0.15
VOICEMATE_MAX_ENDPOINTING_DELAY=0.55
VOICEMATE_MIN_CONSECUTIVE_SPEECH_DELAY=0.12
VOICEMATE_SILERO_MIN_SPEECH_SECONDS=0.12
VOICEMATE_SILERO_MIN_SILENCE_SECONDS=0.24
VOICEMATE_SILERO_PREFIX_PADDING_SECONDS=0.16
VOICEMATE_SILERO_ACTIVATION_THRESHOLD=0.45

# Optional speaker lock for noisy rooms.
VOICEMATE_SPEAKER_LOCK=0
VOICEMATE_SPEAKER_LOCK_MIN_SECONDS=1.2
VOICEMATE_SPEAKER_LOCK_MIN_RMS=260
VOICEMATE_SPEAKER_LOCK_THRESHOLD=0.58
VOICEMATE_SPEAKER_LOCK_LEARN_RATE=0.18
