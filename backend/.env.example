# VoiceMate Backend Configuration
# Copy your DeepSeek API key below.
DEEPSEEK_API_KEY=sk-put_your_deepseek_api_key_here

# Fish Audio for voice cloning.
# Get your API key at https://fish.audio/ if you want cloned voices.
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Optional service overrides.
# DEEPSEEK_MODEL=deepseek-chat
# VOICEMATE_HOST=0.0.0.0
# VOICEMATE_PORT=8000
# VOICEMATE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# VOICEMATE_LLM_MAX_TOKENS=140
# Keep the same AI voice across different emotions/bubbles. Emotion still changes
# rate, pitch, pauses, and text cues, but does not switch to another speaker.
# VOICEMATE_TTS_PROVIDER=edge
# VOICEMATE_TTS_LOCK_VOICE=1
# VOICEMATE_TTS_ALLOW_CLIENT_EDGE_VOICE=0
# ChatTTS is opt-in because it can sample a different speaker across replies.
# VOICEMATE_CHATTTS_ENABLED=0

# Optional Xiaomi MiMo V2.5 TTS provider.
# MiMo is a cloud API, not a local model download. Enable it after getting a key
# from the Xiaomi MiMo Open Platform. Preset voices: Bingtang(冰糖), Moli(茉莉),
# Suda(苏打), Baihua(白桦), Mia, Chloe, Milo, Dean.
# MIMO_API_KEY=your_mimo_api_key_here
# VOICEMATE_TTS_PROVIDER=mimo
# MIMO_TTS_MODEL=mimo-v2.5-tts
# MIMO_TTS_VOICE=冰糖
# MIMO_TTS_CONTEXT=Use a warm, natural companion style with real pauses.
# For realtime calls, keep edge for lower first-audio latency or switch to mimo
# for richer emotion at the cost of waiting for a full WAV response.
# VOICEMATE_REALTIME_TTS_PROVIDER=edge
# Voice clone mode: set model to mimo-v2.5-tts-voiceclone and provide a <=10MB mp3/wav sample.
# MIMO_VOICE_SAMPLE=D:\path\to\voice_sample.wav

# Realtime voice noise filtering.
# Increase thresholds if background voices/noise still trigger replies.
# Realtime ASR now runs on the backend by default. The iOS app only streams mic
# audio; backend VAD + faster-whisper decides the sentence and replies.
# VOICEMATE_ASR_MODEL=base
# VOICEMATE_ASR_DEVICE=cpu
# VOICEMATE_ASR_COMPUTE_TYPE=int8
# VOICEMATE_ASR_MIN_AUDIO_SECONDS=0.75
# VOICEMATE_ASR_MIN_RMS=180
# VOICEMATE_ASR_MAX_NO_SPEECH_PROB=0.65
# VOICEMATE_ASR_MIN_TEXT_CHARS=2
# VOICEMATE_MIN_ENDPOINTING_DELAY=0.55
# VOICEMATE_MAX_ENDPOINTING_DELAY=1.25
# VOICEMATE_MIN_CONSECUTIVE_SPEECH_DELAY=0.35
# VOICEMATE_WHISPER_MIN_SPEECH_MS=300
# VOICEMATE_WHISPER_MIN_SILENCE_MS=520
# VOICEMATE_WHISPER_SPEECH_PAD_MS=240

# Semantic turn detection waits briefly when ASR text looks unfinished,
# for example "I want to ask..." or "if...".
# VOICEMATE_SEMANTIC_TURN_ENABLED=1
# VOICEMATE_SEMANTIC_TURN_DELAY_MS=900
# VOICEMATE_SEMANTIC_TURN_MIN_CHARS=3

# Phone-call style speaker lock. This does not require a wake word:
# the first clear near-field utterance enrolls a lightweight acoustic profile,
# then obvious off-mic/background speech is ignored.
# VOICEMATE_SPEAKER_LOCK=1
# VOICEMATE_SPEAKER_LOCK_MIN_SECONDS=1.2
# VOICEMATE_SPEAKER_LOCK_MIN_RMS=260
# VOICEMATE_SPEAKER_LOCK_THRESHOLD=0.58
# VOICEMATE_SPEAKER_LOCK_LEARN_RATE=0.18

# Legacy WebSocket VAD filtering.
# VOICEMATE_WEBRTC_VAD_MODE=3
# VOICEMATE_VAD_SPEECH_RATIO=2.8
# VOICEMATE_VAD_SILENCE_MS=850
# VOICEMATE_VAD_SHORT_SILENCE_MS=520
# VOICEMATE_VAD_LONG_SILENCE_MS=1050
# VOICEMATE_VAD_MIN_UTTERANCE_MS=700
# VOICEMATE_VAD_PRE_ROLL_MS=300
# VOICEMATE_VAD_CONFIRM_FRAMES=6
# VOICEMATE_BARGE_IN_CONFIRM_FRAMES=8
# VOICEMATE_BARGE_IN_MIN_UTTERANCE_MS=420

# Optional strict mode: only respond when a wake word is heard.
# VOICEMATE_ASR_REQUIRE_WAKE_WORD=1
# VOICEMATE_ASR_WAKE_WORDS=xiao yu,VoiceMate
