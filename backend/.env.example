# VoiceMate Backend Configuration
# Copy your DeepSeek API key below.
DEEPSEEK_API_KEY=sk-put_your_deepseek_api_key_here

# Fish Audio for voice cloning.
# Get your API key at https://fish.audio/ if you want cloned voices.
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Optional service overrides.
# DEEPSEEK_MODEL=deepseek-chat
# VOICEMATE_HOST=0.0.0.0
# VOICEMATE_PORT=8000
# VOICEMATE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# VOICEMATE_LLM_MAX_TOKENS=140

# Realtime voice noise filtering.
# Increase thresholds if background voices/noise still trigger replies.
# VOICEMATE_ASR_MIN_AUDIO_SECONDS=0.75
# VOICEMATE_ASR_MIN_RMS=180
# VOICEMATE_ASR_MAX_NO_SPEECH_PROB=0.65
# VOICEMATE_ASR_MIN_TEXT_CHARS=2
# VOICEMATE_MIN_ENDPOINTING_DELAY=0.55
# VOICEMATE_MAX_ENDPOINTING_DELAY=1.25
# VOICEMATE_MIN_CONSECUTIVE_SPEECH_DELAY=0.35

# Phone-call style speaker lock. This does not require a wake word:
# the first clear near-field utterance enrolls a lightweight acoustic profile,
# then obvious off-mic/background speech is ignored.
# VOICEMATE_SPEAKER_LOCK=1
# VOICEMATE_SPEAKER_LOCK_MIN_SECONDS=1.2
# VOICEMATE_SPEAKER_LOCK_MIN_RMS=260
# VOICEMATE_SPEAKER_LOCK_THRESHOLD=0.58
# VOICEMATE_SPEAKER_LOCK_LEARN_RATE=0.18

# Legacy WebSocket VAD filtering.
# VOICEMATE_WEBRTC_VAD_MODE=3
# VOICEMATE_VAD_SPEECH_RATIO=2.8
# VOICEMATE_VAD_SILENCE_MS=850
# VOICEMATE_VAD_MIN_UTTERANCE_MS=700
# VOICEMATE_VAD_CONFIRM_FRAMES=6
# VOICEMATE_BARGE_IN_CONFIRM_FRAMES=8

# Optional strict mode: only respond when a wake word is heard.
# VOICEMATE_ASR_REQUIRE_WAKE_WORD=1
# VOICEMATE_ASR_WAKE_WORDS=xiao yu,VoiceMate
